{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATS v4 - Plugin declarativo de diagnostico",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "toolId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!\\s*$)[^\\x00-\\x1f\\x7f]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^(?!\\s*$)[^\\x00-\\x1f\\x7f]+$"
    },
    "toolId": {
      "type": "integer",
      "enum": [
        1,
        14,
        19,
        27,
        28,
        30
      ]
    }
  }
}
