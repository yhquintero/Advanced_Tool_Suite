# Archivos locales y resultados de pruebas
__pycache__/
*.py[cod]
.venv/

# No versionar informes con datos del equipo
Reportes/
actividad.log

# Distribuciones, auditoria y datos locales sensibles
/artifacts/
*.log
*.log.*
*.jsonl
*.dpapi
*.clixml

# Secretos y claves privadas: nunca versionar
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key

# Metadatos locales del sistema
.DS_Store
Thumbs.db

